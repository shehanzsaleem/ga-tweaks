{
  "manifest_version": 3,
  "name": "GA Tweaks",
  "version": "2.0.0",
  "description": "Google Analytics 4 tweaks: Estimated Revenue and next-month cards, a Views forecast, and a compact layout with full-width cards (Alt+C).",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://analytics.google.com/*"
      ],
      "css": [
        "compact.css"
      ],
      "js": [
        "compact.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://analytics.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://analytics.google.com/*"
      ],
      "js": [
        "forecast.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "GA Tweaks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111"
}
